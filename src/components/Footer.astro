---
import { site, nav } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const externalLinks = site.links.filter((link) => link.url && /^https?:/i.test(link.url));
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label="页脚导航">
      <ul>
        {nav.map((item) => <li><a href={withBase(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>
    {
      externalLinks.length > 0 && (
        <p>
          其他链接：
          {externalLinks.map((link, i) => (
            <>
              {i > 0 && ' · '}
              <a href={link.url} rel="me noopener" target="_blank">
                {link.label}
              </a>
            </>
          ))}
        </p>
      )
    }
    <p>{site.footerNote}</p>
    <p>© {year} {site.name} · 本站内容除特别说明外均为原创，转载请注明出处。</p>
  </div>
</footer>
