---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="页面不存在">
  <div class="container">
    <section class="hero">
      <h1>404</h1>
      <p class="tagline">这个地址没有内容。</p>
      <p class="action"><a class="btn btn-primary" href={withBase('/')}>返回首页</a></p>
    </section>
  </div>
</BaseLayout>
