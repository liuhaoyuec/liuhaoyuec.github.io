---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { isPlaceholder } from '../lib/placeholder';

const email = site.info.find((item) => item.label === '邮箱')?.value ?? '';
const hasEmail = !isPlaceholder(email);
const links = site.links.filter((link) => link.url);
const infoItems = site.info.filter((item) => item.value && item.label !== '邮箱');
---

<BaseLayout title="联系" description="联系方式与合作交流" narrow>
  <div class="section-head">
    <h1>联系</h1>
  </div>

  <p class="lede">{site.contactNote}</p>

  {
    hasEmail && (
      <p>
        邮箱：
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    )
  }

  <p>
    {hasEmail
      ? '邮件是我最可靠的联络方式，欢迎就研究合作、论文讨论或资料勘误写信给我。'
      : '［待补充：在 src/data/site.ts 的 info 中填写邮箱后，这里会自动显示联系邮箱与邮件按钮。］'}
  </p>

  {
    infoItems.length > 0 && (
      <ul class="info-list">
        {infoItems.map((item) => (
          <li>
            <span class="label">{item.label}</span>
            <span class:list={[isPlaceholder(item.value) && 'placeholder-text']}>{item.value}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    links.length > 0 && (
      <section class="section mt-lg">
        <div class="section-head">
          <h2>其他链接</h2>
        </div>
        <div class="link-row">
          {links.map((link) =>
            isPlaceholder(link.url) ? (
              <span class="placeholder-text">{link.label}</span>
            ) : (
              <a
                href={link.url}
                rel="me noopener"
                target={link.url.startsWith('http') ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ),
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="section-head">
      <h2>关于资料访问</h2>
    </div>
    <p>
      资料区的公开内容可直接下载。需要登录才能访问的资料（例如课件、数据集）将在后续接入账号系统后开放，
      届时会在这里说明申请方式。
    </p>
    <p class="muted">{site.footerNote}</p>
  </section>
</BaseLayout>
