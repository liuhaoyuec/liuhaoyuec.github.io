---
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, resources } from '../data/site';
import { withBase } from '../lib/url';

/** 极小的模糊占位图，主背景加载完成前先铺一层夜色光晕 */
const lqip = `data:image/webp;base64,${readFileSync(
  new URL('../../public/images/hero-lqip.webp', import.meta.url),
).toString('base64')}`;

/** 光粒位置是固定的，避免每次刷新跳变；改数量即可调整密度 */
const motes = Array.from({ length: 18 }, (_, i) => ({
  x: (i * 37 + 9) % 94 + 3,
  y: (i * 53 + 7) % 82 + 6,
  size: i % 5 === 0 ? 4 : 2,
  delay: ((i * 7) % 17) * 0.9,
  duration: 11 + ((i * 5) % 9),
  drift: ((i * 13) % 80) - 40,
  opacity: i % 4 === 0 ? 0.85 : 0.5,
}));
---

<BaseLayout bodyClass="home">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={withBase('/images/hero-night-mobile.webp')}
      media="(max-width: 900px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={withBase('/images/hero-night.webp')}
      imagesrcset={`${withBase('/images/hero-night-1280.webp')} 1280w, ${withBase('/images/hero-night.webp')} 1672w`}
      imagesizes="100vw"
      media="(min-width: 901px)"
      fetchpriority="high"
    />
  </Fragment>

  <section class="home-hero">
    <div class="hero-media" style={`--lqip: url("${lqip}")`} aria-hidden="true">
      <picture>
        <source media="(max-width: 900px)" srcset={withBase('/images/hero-night-mobile.webp')} />
        <img
          src={withBase('/images/hero-night.webp')}
          srcset={`${withBase('/images/hero-night-1280.webp')} 1280w, ${withBase('/images/hero-night.webp')} 1672w`}
          sizes="100vw"
          width="1672"
          height="940"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <div class="hero-motes" aria-hidden="true">
      {motes.map((mote) => (
        <span
          class="mote"
          style={`--x:${mote.x}%; --y:${mote.y}%; --s:${mote.size}px; --delay:${mote.delay}s; --dur:${mote.duration}s; --dx:${mote.drift}px; --o:${mote.opacity}`}
        />
      ))}
    </div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Welcome</p>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={site.fileSpace.url} target="_blank" rel="noopener">
            {site.fileSpace.label}
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#resources">浏览讲义</a>
        </div>
        <p class="hero-note">
          <span class="pulse-dot" aria-hidden="true"></span>
          {resources.length} 份讲义与资料 · 持续更新
        </p>
      </div>
    </div>

    <a class="scroll-cue" href="#resources" aria-label="向下浏览讲义与资料">
      <span>SCROLL</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  {resources.length > 0 && (
    <section class="archive" id="resources" aria-labelledby="resources-title">
      <div class="container">
        <header class="archive-head">
          <div>
            <p class="eyebrow">Archive · 资料库</p>
            <h2 id="resources-title">讲义与资料</h2>
          </div>
          <p class="archive-count">
            <strong>{resources.length}</strong>
            <span>份资料<br />持续更新</span>
          </p>
        </header>

        <ul class="resource-list">
          {resources.map((item, index) => (
            <li class="resource-item reveal" style={`--i:${index}`}>
              <div class="resource-top">
                <span class="resource-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="resource-meta">
                  {item.date} · {item.pages} 页 · {item.file.split('.').pop()?.toUpperCase()}
                </span>
              </div>
              <h3>
                <a href={withBase(item.file)} target="_blank" rel="noopener">
                  {item.title}
                </a>
              </h3>
              <p class="resource-summary">{item.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 滚动浮现：进入视口后淡入上移 */
  const revealTargets = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    revealTargets.forEach((el) => observer.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  }

  /* 首屏背景轻微视差：只挪一点点，避免喧宾夺主 */
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const heroMedia = document.querySelector<HTMLElement>('.hero-media');
  if (hero && heroMedia && !reduceMotion) {
    let ticking = false;
    const syncParallax = () => {
      const offset = Math.min(window.scrollY, hero.offsetHeight);
      heroMedia.style.setProperty('--parallax', `${offset * 0.14}`);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(syncParallax);
        }
      },
      { passive: true },
    );
  }
</script>
