---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="action">
      <a class="btn" href={site.fileSpace.url}>{site.fileSpace.label}</a>
    </p>
  </section>
</BaseLayout>
