---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { research } from '../data/research';
import { news } from '../data/news';
import { withBase } from '../lib/url';
import { formatDate } from '../lib/format';
import { isPlaceholder } from '../lib/placeholder';

const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year,
);
const featured = publications.filter((p) => p.data.featured).slice(0, 3);

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const newsSorted = [...news].sort((a, b) => b.date.localeCompare(a.date));
const infoItems = site.info.filter((item) => item.value);
const linkItems = site.links.filter((link) => link.url);
---

<BaseLayout>
  <section class="hero">
    <h1>{site.name}</h1>
    {site.nameEn && <p class="name-en">{site.nameEn}</p>}
    <p class="tagline">{site.tagline}</p>
    <div>
      {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      infoItems.length > 0 && (
        <ul class="info-list">
          {infoItems.map((item) => (
            <li>
              <span class="label">{item.label}</span>
              <span class:list={[isPlaceholder(item.value) && 'placeholder-text']}>{item.value}</span>
            </li>
          ))}
        </ul>
      )
    }
    {
      linkItems.length > 0 && (
        <p class="links">
          {linkItems.map((link) =>
            isPlaceholder(link.url) ? (
              <span class="link-pill placeholder" title="待补充链接">
                {link.label}
              </span>
            ) : (
              <a
                class="link-pill"
                href={link.url}
                rel="me noopener"
                target={link.url.startsWith('http') ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ),
          )}
        </p>
      )
    }
  </section>

  <section class="section" id="research">
    <div class="section-head">
      <h2>研究方向</h2>
    </div>
    <div class="grid">
      {
        research.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.keywords.length > 0 && (
              <ul class="tags">
                {item.keywords.map((keyword) => (
                  <li>{keyword}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>近期动态</h2>
    </div>
    <ul class="news">
      {
        newsSorted.map((item) => (
          <li>
            <span class="date">{item.date}</span>
            <span class="type">
              <span class="badge">{item.type}</span>
            </span>
            <span>
              {item.text}
              {item.link && (
                <>
                  {' '}
                  <a href={item.link}>{item.link.startsWith('http') ? '链接' : '查看'}</a>
                </>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>代表成果</h2>
      <a class="more" href={withBase('/publications/')}>全部成果 →</a>
    </div>
    <ul class="entry-list">
      {
        featured.map((item) => (
          <li>
            <h3 class="entry-title">{item.data.title}</h3>
            <div class="entry-meta">
              <span>{item.data.authors}</span>
              {(item.data.venue || item.data.year) && (
                <span class="muted">
                  {item.data.venue} {item.data.year}
                </span>
              )}
              <span class="badge plain">{item.data.type}</span>
            </div>
            <p class="entry-body dim">{item.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>近期笔记</h2>
      <a class="more" href={withBase('/notes/')}>全部笔记 →</a>
    </div>
    <ul class="entry-list">
      {
        notes.map((item) => (
          <li>
            <h3 class="entry-title">
              <a href={withBase(`/notes/${item.id}/`)}>{item.data.title}</a>
            </h3>
            <div class="entry-meta">
              <span>{formatDate(item.data.date)}</span>
            </div>
            <p class="entry-body dim">{item.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
