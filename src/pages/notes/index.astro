---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { formatDate } from '../../lib/format';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="笔记" description="学习笔记、技术备忘与阅读记录">
  <div class="section-head">
    <h1>笔记</h1>
    <span class="muted">{notes.length} 篇</span>
  </div>
  <p class="lede">按时间从新到旧排列，内容以 Markdown 编写。</p>

  <ul class="entry-list">
    {
      notes.map((note) => (
        <li>
          <h2 class="entry-title">
            <a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
          </h2>
          <div class="entry-meta">
            <span>{formatDate(note.data.date)}</span>
          </div>
          <p class="entry-body dim">{note.data.summary}</p>
          {note.data.tags.length > 0 && (
            <ul class="tags">
              {note.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  {
    notes.length === 0 && (
      <p class="muted">
        还没有笔记。在 src/content/notes/ 下新增一个 Markdown 文件，例如 src/content/notes/my-note.md。
      </p>
    )
  }
</BaseLayout>
