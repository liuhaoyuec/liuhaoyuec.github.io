---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { formatDate } from '../../lib/format';

const resources = (await getCollection('resources', ({ data }) => !data.draft)).sort((a, b) => {
  const da = a.data.updated?.getTime() ?? 0;
  const db = b.data.updated?.getTime() ?? 0;
  return db - da || a.data.title.localeCompare(b.data.title);
});

// 按分类分组，保持条目出现顺序
const categories = [...new Set(resources.map((item) => item.data.category))];
---

<BaseLayout title="资料" description="讲义、模板、数据集等资料列表与下载链接">
  <div class="section-head">
    <h1>资料</h1>
    <span class="muted">{resources.length} 份</span>
  </div>
  <p class="lede">
    分享整理的讲义、笔记、模板与数据集。当前为公开下载；后续会接入账号登录与独立文件存储，
    便于管理更大体积的资料。
  </p>

  {
    categories.map((category) => (
      <section class="section">
        <div class="section-head">
          <h2>{category}</h2>
        </div>
        <div class="grid">
          {resources
            .filter((item) => item.data.category === category)
            .map((item) => {
              const link = item.data.file
                ? withBase(item.data.file)
                : item.data.url && !item.data.url.includes('待补充')
                  ? item.data.url
                  : '';
              const external = /^https?:/i.test(link);
              return (
                <article class="card">
                  <h3>{item.data.title}</h3>
                  <p class="muted">{item.data.description}</p>
                  <div class="entry-meta">
                    {item.data.updated && <span>{formatDate(item.data.updated)}</span>}
                    {item.data.size && <span>{item.data.size}</span>}
                    {item.data.restricted && <span class="badge">需登录（待开放）</span>}
                  </div>
                  {item.data.tags.length > 0 && (
                    <ul class="tags">
                      {item.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  {link ? (
                    <div class="btn-row">
                      <a
                        class="btn"
                        href={link}
                        {...(external
                          ? { target: '_blank', rel: 'noopener' }
                          : { download: true })}
                      >
                        下载 / 查看
                      </a>
                    </div>
                  ) : (
                    <p class="btn-row muted">［待补充：上传文件到 public/files/ 后填写 file 字段］</p>
                  )}
                </article>
              );
            })}
        </div>
      </section>
    ))
  }

  {
    resources.length === 0 && (
      <p class="muted">还没有资料。在 src/content/resources/ 下新增 Markdown 文件即可。</p>
    )
  }
</BaseLayout>
